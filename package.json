{
  "name": "starter",
  "type": "module",
  "module": "src/server.ts",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "vp dev",
    "test": "vitest",
    "test:browser": "vitest --project browser --passWithNoTests",
    "test:unit": "vitest --project unit",
    "test:integration": "vitest --project integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:coverage": "vitest run --coverage",
    "test:mutate": "stryker run",
    "build": "vp build",
    "preview": "vp preview",
    "typegen": "wrangler types",
    "lint": "vp lint --fix",
    "lint:check": "vp lint",
    "format": "vp fmt --write .",
    "format:check": "vp fmt --check .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:domain": "tsc --noEmit -p tsconfig.domain.json",
    "typecheck:infra": "tsc --noEmit -p tsconfig.infra.json",
    "typecheck:api": "tsc --noEmit -p tsconfig.api.json",
    "typecheck:webapp": "tsc --noEmit -p tsconfig.webapp.json",
    "typecheck:test": "pnpm typecheck:test:unit && pnpm typecheck:test:integration && pnpm typecheck:test:browser && pnpm typecheck:test:e2e",
    "typecheck:test:unit": "tsc --noEmit -p tsconfig.test.unit.json",
    "typecheck:test:integration": "tsc --noEmit -p tsconfig.test.integration.json",
    "typecheck:test:browser": "tsc --noEmit -p tsconfig.test.browser.json",
    "typecheck:test:e2e": "tsc --noEmit -p tsconfig.test.e2e.json",
    "typecheck:layers": "pnpm typecheck:domain && pnpm typecheck:infra && pnpm typecheck:api && pnpm typecheck:webapp",
    "codebase:analyze": "fallow",
    "codebase:audit": "fallow audit",
    "codebase:dead-code": "fallow dead-code",
    "codebase:duplicates": "fallow dupes",
    "codebase:health": "fallow health",
    "codebase:boundaries": "fallow list --boundaries",
    "codebase:boundary-violations": "fallow dead-code --boundary-violations",
    "codebase:fix:dry-run": "fallow fix --dry-run",
    "fallow": "fallow",
    "fallow:ci": "pnpm codebase:audit",
    "ci": "pnpm lint:check && pnpm format:check && pnpm typecheck:layers && pnpm typecheck && pnpm typecheck:test && pnpm codebase:audit",
    "fix": "pnpm lint && pnpm format",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@chakra-ui/charts": "^3.34.0",
    "@chakra-ui/react": "^3.34.0",
    "@emotion/react": "^11.14.0",
    "@hono/zod-openapi": "^1.3.0",
    "@tanstack/react-router": "^1.114.3",
    "@tanstack/react-start": "^1.166.18",
    "better-auth": "^1.4.10",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.8",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.7",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.30.0",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.51.0",
    "@stryker-mutator/core": "^9.5.1",
    "@stryker-mutator/vitest-runner": "^9.5.1",
    "@testcontainers/postgresql": "^11.11.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/coverage-v8": "^4.1.9",
    "acorn": "^8.16.0",
    "drizzle-kit": "^0.31.8",
    "fallow": "^2.48.1",
    "happy-dom": "^20.0.11",
    "jiti": "^2.6.1",
    "lefthook": "^2.1.6",
    "msw": "^2.13.6",
    "playwright": "*",
    "testcontainers": "^11.11.0",
    "typescript": "^5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "^2.1.0",
    "wrangler": "^4.76.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.34.5"
}
