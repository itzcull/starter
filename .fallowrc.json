{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/server.ts",
    "src/webapp/router.tsx",
    "src/**/*.{test,spec}.{ts,tsx}",
    "test/**/*.{ts,tsx}",
    "e2e/**/*.{ts,tsx}",
    "oxfmt.config.ts",
    "oxlint.config.ts",
    "stryker.config.mjs",
    "vitest.mutation.config.ts"
  ],
  "ignoreDependencies": [
    "@chakra-ui/charts",
    "@edge-runtime/vm",
    "@emotion/react",
    "@stryker-mutator/vitest-runner",
    "jiti",
    "react",
    "recharts",
    "testcontainers",
    "vitest-browser-react",
    "zod"
  ],
  "rules": {
    "boundary-violation": "error",
    "unused-dependencies": "warn"
  },
  "boundaries": {
    "zones": [
      { "name": "domain", "patterns": ["src/domain/**"] },
      { "name": "infra", "patterns": ["src/infra/**"] },
      { "name": "api", "patterns": ["src/api/**"] },
      { "name": "webapp", "patterns": ["src/webapp/**"] },
      { "name": "server", "patterns": ["src/server.ts"] }
    ],
    "rules": [
      { "from": "domain", "allow": [] },
      { "from": "infra", "allow": ["domain"] },
      { "from": "api", "allow": ["domain", "infra"] },
      { "from": "webapp", "allow": ["domain", "api"] },
      { "from": "server", "allow": ["domain", "infra", "api", "webapp"] }
    ]
  }
}
