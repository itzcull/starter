{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["esnext", "DOM"],
    "types": ["vite/client"],
    "paths": {
      "@domain/*": ["./src/domain/*"],
      "@infra/*": ["./src/infra/*"],
      "@test-utils/*": [
        "./test/unit/*",
        "./test/integration/*",
        "./test/browser/*",
        "./e2e/test-utils/*"
      ],
      "@theme": ["./src/webapp/theme"]
    }
  },
  "exclude": ["node_modules", "dist", "build"],
  "include": ["**/*", "src/webapp/routeTree.gen.ts"]
}
